{
  "name": "lipetsk-site-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture baseline for reusable service lead websites",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:plan": "node scripts/verify-plan.mjs",
    "verify:architecture": "npm run check:plan && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
