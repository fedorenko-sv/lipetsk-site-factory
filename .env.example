# Значения секретов не хранить в Git и не присылать в чат.
# Серверный агент добавляет validation; наличие этого файла не включает live.
DATABASE_URL=
TEST_DATABASE_URL=
ALLOWED_ORIGINS=
ALLOWED_SITE_KEYS=auto,beauty,detailing,medical,sports,stay,estimate
ENABLE_LIVE_LEADS=
LEAD_RETENTION_DAYS=
IDEMPOTENCY_HMAC_KEY=
RATE_LIMIT_HMAC_KEY=
OUTBOX_SECRET=
# Канал и версия назначения выбираются для конкретного заказчика.
NOTIFICATION_ADAPTER=
NOTIFICATION_DESTINATION_KEY=
# Версионированные назначения для нескольких демо; только сервер.
SITE_DESTINATIONS_JSON='{"auto":{"destinationKey":"demo-auto-v1","version":1},"beauty":{"destinationKey":"demo-beauty-v1","version":1},"detailing":{"destinationKey":"demo-detailing-v1","version":1},"medical":{"destinationKey":"demo-medical-v1","version":1},"sports":{"destinationKey":"demo-sports-v1","version":1},"stay":{"destinationKey":"demo-stay-v1","version":1},"estimate":{"destinationKey":"demo-estimate-v1","version":1}}'
NOTIFICATION_DESTINATIONS_JSON='{"demo-auto-v1":{"adapterId":"recording"},"demo-beauty-v1":{"adapterId":"recording"},"demo-detailing-v1":{"adapterId":"recording"},"demo-medical-v1":{"adapterId":"recording"},"demo-sports-v1":{"adapterId":"recording"},"demo-stay-v1":{"adapterId":"recording"},"demo-estimate-v1":{"adapterId":"recording"}}'
# Заголовок IP разрешается только вместе с документированным доверенным ingress.
TRUSTED_IP_HEADER=
# Allowlist UTM в attribution (по умолчанию выключена).
ATTRIBUTION_ENABLED=
# Только при выборе Telegram. Другие адаптеры документируют свои env отдельно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Необязательно: standalone demo (auto/beauty/medical/sports/stay/estimate).
# ALLOWED_SITE_KEYS должен точно совпадать с профилем; Auto включает auto,detailing.
DEMO_SITE_KEY=
