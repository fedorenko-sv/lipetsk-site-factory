{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siteKey",
    "configVersion",
    "kind",
    "parameters",
    "customer",
    "consent",
    "antiBot"
  ],
  "properties": {
    "siteKey": {
      "const": "estimate"
    },
    "configVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "kind": {
      "const": "estimate"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "widthMm",
        "heightMm",
        "quantity",
        "glazing",
        "finish",
        "installation"
      ],
      "properties": {
        "product": {
          "enum": [
            "window",
            "balcony-door"
          ]
        },
        "widthMm": {
          "type": "integer",
          "minimum": 600,
          "maximum": 2400,
          "multipleOf": 100
        },
        "heightMm": {
          "type": "integer",
          "minimum": 600,
          "maximum": 2400,
          "multipleOf": 100
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "glazing": {
          "enum": [
            "double",
            "triple"
          ]
        },
        "finish": {
          "enum": [
            "white",
            "graphite"
          ]
        },
        "installation": {
          "type": "boolean"
        }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "string",
          "minLength": 10,
          "maxLength": 30
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "phone"
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": [
        "accepted",
        "version"
      ]
    },
    "antiBot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {
          "type": "string",
          "maxLength": 0
        }
      },
      "required": [
        "website"
      ]
    }
  }
}
