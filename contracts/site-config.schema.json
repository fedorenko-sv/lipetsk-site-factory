{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lipetsk-site-factory.example/schemas/site-config.json",
  "title": "Public SiteConfig 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "mode": {
      "enum": [
        "demo",
        "live"
      ]
    },
    "core": {
      "const": "booking"
    },
    "theme": {
      "enum": [
        "technical",
        "editorial"
      ]
    },
    "locale": {
      "const": "ru-RU"
    },
    "timezone": {
      "const": "Europe/Moscow"
    },
    "brandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "ctaText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "eyebrow",
        "title",
        "subtitle",
        "ctaText"
      ]
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+7[0-9]{10}$"
        },
        "messengerUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 200
        }
      },
      "required": []
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "priceDisclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 480
          },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "fixed",
                  "from"
                ]
              },
              "amountMinor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "currency": {
                "const": "RUB"
              }
            },
            "required": [
              "kind",
              "amountMinor",
              "currency"
            ]
          },
          "resourceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$"
            },
            "maxItems": 30
          },
          "options": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,39}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "required": {
                  "type": "boolean"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "label",
                "required",
                "values"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "durationMinutes",
          "price",
          "resourceIds",
          "options"
        ]
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceSelection": {
          "enum": [
            "hidden",
            "optional",
            "required"
          ]
        },
        "preferenceRequired": {
          "type": "boolean"
        },
        "horizonDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "timeStepMinutes": {
          "enum": [
            15,
            30,
            60
          ]
        },
        "workingHours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opens": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "closes": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "days": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            }
          },
          "required": [
            "opens",
            "closes",
            "days"
          ]
        }
      },
      "required": [
        "resourceSelection",
        "preferenceRequired",
        "horizonDays",
        "timeStepMinutes",
        "workingHours"
      ]
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "policyPath": {
          "type": "string",
          "pattern": "^/demo/[a-z][a-z0-9-]{0,39}/privacy$"
        },
        "operatorName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "approved": {
          "type": "boolean"
        }
      },
      "required": [
        "consentVersion",
        "policyPath",
        "operatorName",
        "approved"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "contentVersion",
    "mode",
    "core",
    "theme",
    "locale",
    "timezone",
    "brandName",
    "hero",
    "contacts",
    "address",
    "priceDisclaimer",
    "services",
    "resources",
    "booking",
    "legal"
  ]
}
