{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Lipetsk Site Factory — Lead API",
    "version": "1.0.0",
    "description": "Только заявки Booking. Успех не подтверждает бронь или доставку уведомления."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Локальная разработка"
    }
  ],
  "tags": [
    {
      "name": "Leads",
      "description": "Получение заявки без публичного чтения"
    }
  ],
  "paths": {
    "/api/leads": {
      "post": {
        "operationId": "createLead",
        "tags": [
          "Leads"
        ],
        "summary": "Сохранить заявку и задание уведомления",
        "security": [],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID, один для одной попытки и её сетевых повторов"
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Явный same-origin allowlist окружения"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadCreateRequest"
              },
              "example": {
                "siteKey": "auto",
                "configVersion": "demo-2026-11-04",
                "kind": "booking",
                "serviceId": "tire-change",
                "serviceOptions": {
                  "wheel-size": "R16"
                },
                "preferred": {
                  "date": "2026-11-06",
                  "time": "10:30",
                  "timezone": "Europe/Moscow"
                },
                "customer": {
                  "phone": "+70000000000"
                },
                "consent": {
                  "accepted": true,
                  "version": "demo-2026-11-04"
                },
                "antiBot": {
                  "website": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Идентичный повтор, тот же leadId и replayed=true",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Новый lead и outbox подтверждены COMMIT",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Невалидный JSON или отсутствующий ключ",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Origin не разрешён",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Сайт недоступен",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт ключа или версии данных/согласия",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Тело больше 16 KiB",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Требуется application/json",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка полей или honeypot",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Лимит новых попыток",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Retry-After": {
                "description": "Число секунд до повтора",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Безопасная внутренняя ошибка",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище/режим не готовы",
            "headers": {
              "Cache-Control": {
                "description": "Всегда no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LeadCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "siteKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "configVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "kind": {
            "const": "booking"
          },
          "serviceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "serviceOptions": {
            "type": "object",
            "maxProperties": 5,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$"
            }
          },
          "resourceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "preferred": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "time": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "timezone": {
                "const": "Europe/Moscow"
              }
            },
            "required": [
              "date",
              "time",
              "timezone"
            ]
          },
          "customer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phone": {
                "type": "string",
                "minLength": 10,
                "maxLength": 30
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "phone"
            ]
          },
          "consent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accepted": {
                "const": true
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            },
            "required": [
              "accepted",
              "version"
            ]
          },
          "attribution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "utm_source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "utm_medium": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "utm_campaign": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": []
          },
          "antiBot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "website": {
                "type": "string",
                "maxLength": 0
              }
            },
            "required": [
              "website"
            ]
          }
        },
        "required": [
          "siteKey",
          "configVersion",
          "kind",
          "serviceId",
          "serviceOptions",
          "customer",
          "consent",
          "antiBot"
        ]
      },
      "LeadReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "leadId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "received"
          },
          "replayed": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "leadId",
          "status",
          "replayed",
          "message"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_JSON",
                  "IDEMPOTENCY_REQUIRED",
                  "ORIGIN_NOT_ALLOWED",
                  "SITE_NOT_FOUND",
                  "IDEMPOTENCY_CONFLICT",
                  "CONFIG_CHANGED",
                  "CONSENT_CHANGED",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_FAILED",
                  "REQUEST_REJECTED",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "STORAGE_UNAVAILABLE",
                  "DEMO_NOT_READY",
                  "LIVE_NOT_READY"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "fieldErrors": {
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
